# PSR Maintenance Services - Environment Variables

# n8n webhooks. In production these are same-origin paths: the [[redirects]]
# proxy in netlify.toml forwards /n8n/* to the real n8n webhooks, because n8n
# sends no CORS headers and a direct browser call fails the preflight.
# For local development (no Netlify proxy), set the absolute webhook URL
# instead, e.g. https://<your-n8n-host>/webhook/<webhook-id>.

# Quote form submissions — Webhook -> data_enrichment -> Basic LLM Chain
# -> Code in JavaScript -> Call 'send_to_customer'
VITE_QUOTE_WEBHOOK_URL="/n8n/quote"

# AI chat widget — receives chatInput/sessionId/systemPrompt
VITE_CHAT_WEBHOOK_URL="/n8n/chat"

# Google Maps API Key (for embedded map)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Site URL (for SEO)
VITE_SITE_URL=""

# Company contact info (name/phone/email/WhatsApp) is centralized in
# src/config/companyInfo.js, not read from env vars.

# oryonLabsDB backend API in railway (admin CRM panel under /admin)
VITE_API_BASE_URL=https://oryonlabsdb-production.up.railway.app/api
